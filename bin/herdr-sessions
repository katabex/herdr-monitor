}

require_tools() {
  local tool
  for tool in herdr jq; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is not installed"
  done
}

# -------------------------------------------------------------- machines

# The cache directory, without private_dir's purge: the listing keeps live
# state in here - SSH control sockets, the last answer from each machine -
# and a multiplexed connection is only worth keeping if it survives longer
# than one poll. The ownership checks stay, because the directory is still
# ours and still writable by a symlink somebody else left behind.
quiet_private_dir() {
  local dir="$1" owner
  mkdir -p -m 700 -- "$dir" 2>/dev/null
  [[ -d $dir && ! -L $dir ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ $owner == "$(id -u)" ]] || return 1
  return 0
}

# One shared control socket per SSH destination, so a warm poll costs a
# packet rather than a handshake. BatchMode keeps a machine that wants a
# password from sitting at a prompt the widget cannot see; ConnectTimeout
# and the `timeout` around each call keep one that went away from holding
# the list hostage. The socket lives in the cache directory, which is 700.
REMOTE_SSH_OPTS=(-o BatchMode=yes
  -o ConnectTimeout="$REMOTE_CONNECT_TIMEOUT"
  -o ControlMaster=auto
  -o ControlPath="$CACHE_DIR/ssh-%C"
  -o ControlPersist="${REMOTE_CACHE_PERSIST}s")

# id<TAB>label<TAB>target<TAB>session, one line per enabled machine. herdr
# owns this list - `herdr machine add` wrote it - so it is read rather than
# reproduced, and a herdr that will not answer simply yields no machines
# rather than taking the local list down with it.
machines_tsv() {
  local json
  json=$(herdr machine list --json 2>/dev/null | head -c "$((MACHINES_BYTE_CAP + 1))") || true
  [[ -n $json ]] || return 0
  over_byte_cap "$json" "$MACHINES_BYTE_CAP" && return 0
  printf '%s' "$json" |
    jq -r 'map(select(.enabled == true))
           | map([(.id // ""), (.label // .target // ""), (.target // ""),
                  (.session // "default")] | @tsv) | .[]' 2>/dev/null || true
}

# A saved machine's row key: "<profile id>:<session>". The id is opaque and
# stable for the life of the profile, which is what a row has to be keyed on
# - a label can be renamed between two polls, and a target can be pointed
# somewhere else.
machine_row_key() {
  printf '%s:%s' "$1" "$3"
}

# "target<TAB>row key" for every machine about to be listed, so a window
# running `herdr --remote <target>` can be paired with the machine's row the
# same way a local window is paired with its session. Two profiles on one
# target cannot both be paired; the last one wins, which is the least
# surprising answer for a case herdr itself treats as unusual.
machine_window_pairs() {
  local id label target session
  while IFS=$'\t' read -r id label target session; do
    [[ $id =~ ^[A-Za-z0-9_-]{6,64}$ ]] || continue
    [[ -n $target && $target != *$'\n'* && $target != *" "* ]] || continue
    valid_session_name "$session" || continue
    printf '%s\t%s\n' "$target" "$(machine_row_key "$id" "$label" "$session")"
  done
}

# Where herdr lives on a machine. SSH commands run without a login shell, so
# a binary in ~/.local/bin is not on the PATH they see - the resolved path is
# asked for once, remembered, and only asked for again when it stops working.
remote_herdr_bin() {
  local target="$1" id="$2" p
  local dir="$CACHE_DIR/machines"
  local pathfile="$dir/$id.path"
  if readable_file "$pathfile"; then
    p=$(head -c 4096 -- "$pathfile" 2>/dev/null) || p=""
    if [[ $p =~ ^/[A-Za-z0-9._+@/-]{1,255}$ ]]; then
      printf '%s' "$p"
      return 0
    fi
  fi
  p=$(timeout "$REMOTE_CALL_TIMEOUT" ssh "${REMOTE_SSH_OPTS[@]}" "$target" \
      'sh -lc "command -v herdr" 2>/dev/null || ls -d "$HOME/.local/bin/herdr" 2>/dev/null' 2>/dev/null |
      head -n1 | head -c 4096) || true
  p=${p%$'\r'}
  # The answer is spliced into a later remote command, so it is a path or it
  # is nothing: the shape refuses every shell metacharacter there is.
  [[ $p =~ ^/[A-Za-z0-9._+@/-]{1,255}$ ]] || return 1
  quiet_private_dir "$dir" || return 1
  printf '%s' "$p" > "$pathfile.tmp" && mv -f -- "$pathfile.tmp" "$pathfile"
  printf '%s' "$p"
}

# One machine's snapshot, from its own server, over SSH. `--session` is left
# off for a profile's default session for the same reason as locally: naming
# it would address a *named* remote session that happens to be called
# "default", which is a different server.
remote_snapshot() {
  local target="$1" bin="$2" session="$3" out
  local -a cmd=("$bin")
  [[ $session == default ]] || cmd+=(--session "$session")
  cmd+=(api snapshot)
  # `|| true` for the same reason as the local snapshot: the byte cap in
  # front can close the pipe on ssh and that is a bounded read, not a failure.
  out=$(timeout "$REMOTE_CALL_TIMEOUT" ssh "${REMOTE_SSH_OPTS[@]}" "$target" "${cmd[*]}" 2>/dev/null |
        head -c "$((SNAPSHOT_BYTE_CAP + 1))") || true
  [[ -n $out ]] || return 1
  over_byte_cap "$out" "$SNAPSHOT_BYTE_CAP" && return 1
  printf '%s' "$out"
}

# Ask every enabled machine in parallel. Each writes its answer - or a
# marker that it had none - under the cache directory, and the caller reads
# the files back once every job has landed. Parallel rather than in a row,
# because a machine that went away costs its whole timeout and the herd
# behind it should not wait for that.
gather_machines() {
  command -v ssh >/dev/null 2>&1 || return 0
  quiet_private_dir "$CACHE_DIR" || return 0
  quiet_private_dir "$CACHE_DIR/machines" || return 0
  local id label target session seen=0
  while IFS=$'\t' read -r id label target session; do
    [[ $id =~ ^[A-Za-z0-9_-]{6,64}$ ]] || continue
    [[ -n $target && $target != *$'\n'* && $target != *" "* ]] || continue
    valid_session_name "$session" || continue
    (( seen >= REMOTE_COUNT_CAP )) && break
    seen=$((seen + 1))
    (
      rm -f -- "$CACHE_DIR/machines/$id.snap" "$CACHE_DIR/machines/$id.miss"
      local bin
      bin=$(remote_herdr_bin "$target" "$id") || {
        : > "$CACHE_DIR/machines/$id.miss"
        exit 0
      }
      local snap
      snap=$(remote_snapshot "$target" "$bin" "$session") || {
        # A snapshot that fails after the binary was found may mean the
        # remembered path went stale - an update moved it - so it is dropped
        # and the next poll resolves it again rather than trusting it
        # forever. A host that is simply down fails the same way and costs
        # the same one resolve when it comes back.
        rm -f -- "$CACHE_DIR/machines/$id.path"
        : > "$CACHE_DIR/machines/$id.miss"
        exit 0
      }
      printf '%s' "$snap" > "$CACHE_DIR/machines/$id.snap.tmp" &&
        mv -f -- "$CACHE_DIR/machines/$id.snap.tmp" "$CACHE_DIR/machines/$id.snap"
    ) &
  done
  wait
}

# --------------------------------------------------------------- windows

# One step up the process tree. Read from /proc rather than kept in an array
# of every process on the machine: only the handful of herdr clients are ever
# walked, and each walk is a few reads.
#
# The comm field is in brackets and can hold spaces, so the line is cut after
# the closing bracket before splitting: what follows is state, then ppid.
parent_pid() {
  local line rest
  { read -r line < "/proc/$1/stat"; } 2>/dev/null || return 1
  rest=${line#*") "}
  # shellcheck disable=SC2086
  set -- $rest
  [[ ${2-} =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$2"
}

# Which Hyprland window is showing which session.
#
# The launcher puts `herdr --session <name>` on the terminal's own command
# line, so most windows are recognised from that alone. A herdr started by
# hand inside an existing terminal is not, so the client processes are walked
# up to their window instead: a process named exactly `herdr` is the client,
# `herdr server` is not.
#
# A remote attach - `herdr --remote <target> [--session <name>]` - is a
# window on no local session at all, and on a command line with no --session
# it would otherwise read as "default" and light up the shared session's
# row. It is paired with its machine's row instead, when the target is a
# saved machine; an attach to anywhere else is left alone.
#
# Prints "session<TAB>address<TAB>workspace" per line. Sessions without a
# window are absent.
window_map() {
  command -v hyprctl >/dev/null 2>&1 || return 0

  # "<ssh target>\t<row key>" for every machine the list is showing, read
  # from the pairs file the listing keeps beside its cache.
  declare -A remote_key_of=()
  local pairs="${1-}" pair_target pair_key
  if [[ -n $pairs ]] && readable_file "$pairs"; then
    while IFS=$'\t' read -r pair_target pair_key; do
      [[ -n $pair_target && -n $pair_key ]] || continue
      remote_key_of[$pair_target]=$pair_key
    done < "$pairs"
  fi

  local clients
  clients=$(hyprctl clients -j 2>/dev/null | head -c "$((WINDOWS_BYTE_CAP + 1))") || true
  [[ -n $clients ]] || return 0
  # Window titles are set by whatever is running in them. Without a ceiling a
  # single window could decide how much this costs.
  over_byte_cap "$clients" "$WINDOWS_BYTE_CAP" && return 0

  declare -A window_of_pid=()
  local pid address workspace
  while IFS=$'\t' read -r pid address workspace; do
    [[ -n $pid && -n $address ]] || continue
    window_of_pid[$pid]=$address$'\t'$workspace
  done < <(printf '%s' "$clients" |
    jq -r '.[] | select(.pid > 0)
           | "\(.pid)\t\(.address)\t\(.workspace.name // "")"' 2>/dev/null)

  ((${#window_of_pid[@]})) || return 0

  # Only the herdr processes are read in. Reading every command line on the
  # machine into an array cost more than every other step in this script put
  # together, and all but a handful of those lines never mention herdr.
  declare -A args_of=()
  while read -r pid args; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    args_of[$pid]=$args
  done < <(ps -eo pid=,args= 2>/dev/null | grep -E 'her[d]r')

  declare -A seen=()

  emit() {
    local session="$1" window="$2"
    [[ -n ${seen[$session]-} ]] && return 0
    seen[$session]=1
    printf '%s\t%s\n' "$session" "$window"
  }

  # Read a session name out of a command line that runs herdr. The answer
  # comes back in $found_session rather than on stdout: a command
  # substitution forks a subshell, and this is called once per process on the
  # machine. Through a `$()` it cost a third of a second per refresh.
  local found_session=""
  session_in_args() {
    found_session=""
    local -a words
    read -r -a words <<<"${1-}"
    local i j name remote_target="" key key_session
    for ((i = 0; i < ${#words[@]}; i++)); do
      [[ ${words[i]##*/} == herdr ]] || continue
      # `herdr server` is the background process, not a window's client, and
      # neither is the SSH bridge a client keeps to a machine: the bridge's
      # command line names a herdr binary on another host, and walking up
      # from it would reach whatever window the client that owns it is in.
      case ${words[i + 1]-} in server|remote-client-bridge) return 1 ;; esac
      name=default
      remote_target=""
      for ((j = i + 1; j < ${#words[@]}; j++)); do
        if [[ ${words[j]} == --session ]]; then
          name=${words[j + 1]-}
        elif [[ ${words[j]} == --remote ]]; then
          remote_target=${words[j + 1]-}
        fi
      done
      if [[ -n $remote_target ]]; then
        key=${remote_key_of[$remote_target]-}
        [[ -n $key ]] || return 1
        # A window attached to some other session on the same host is not a
        # window on the profile's row; only the session the profile targets
        # lights it up.
        key_session=${key##*:}
        [[ $name == "$key_session" ]] || return 1
        found_session=$key
        return 0
      fi
      valid_session_name "$name" || return 1
      found_session=$name
      return 0
    done
    return 1
  }

  # The terminal's own command line first: that is how the launcher starts one.
  for pid in "${!window_of_pid[@]}"; do
    session_in_args "${args_of[$pid]-}" || continue
    emit "$found_session" "${window_of_pid[$pid]}"
  done

  # Then anything started by hand, walked up from the client to its window.
  local ancestor hops
  for pid in "${!args_of[@]}"; do
    session_in_args "${args_of[$pid]}" || continue
    ancestor=$pid
    for ((hops = 0; hops < 12; hops++)); do
      ancestor=$(parent_pid "$ancestor") || break
      [[ -n $ancestor && $ancestor != 0 && $ancestor != 1 ]] || break
      if [[ -n ${window_of_pid[$ancestor]-} ]]; then
        emit "$found_session" "${window_of_pid[$ancestor]}"
        break
      fi
    done
  done
}

# ---------------------------------------------------------------- listing

# One session's agents and workspaces, from its own server. `--session` is
# left off for the default one: passing it by name would address a *named*
# session that happens to be called "default", which is a different server.
snapshot_for() {
  local name="$1" is_default="$2"
  local out
  # `|| true` because the cap in front of this can close the pipe on the
  # server, and a SIGPIPE there is a bounded read rather than a failure.
  if [[ $is_default == true ]]; then
    out=$(herdr api snapshot 2>/dev/null | head -c "$((SNAPSHOT_BYTE_CAP + 1))") || true
  else
    out=$(herdr --session "$name" api snapshot 2>/dev/null | head -c "$((SNAPSHOT_BYTE_CAP + 1))") || true
  fi
  [[ -n $out ]] || return 1
  # One oversized server is skipped rather than allowed to take the list down:
  # the row falls back to what session.json remembers, the same as a session
  # whose server never answered.
  over_byte_cap "$out" "$SNAPSHOT_BYTE_CAP" && return 1
  printf '%s' "$out"
}

cmd_list() {
  local sessions_json
  sessions_json=$(herdr session list --json 2>/dev/null | head -c "$((SESSIONS_BYTE_CAP + 1))") || true
  [[ -n $sessions_json ]] || die "could not reach herdr"
  over_byte_cap "$sessions_json" "$SESSIONS_BYTE_CAP" && die "session list too large to read safely"

  # The saved machines are asked before the windows are read, because the
  # pairing wants to know which SSH targets mean which rows before it looks
  # at a window. The asking itself is parallel SSH work inside; what is left
  # behind is a pairs file that couples a `herdr --remote` window to a
  # machine's row, exactly as a command line with `--session` is coupled to
  # a local one.
  local machines pairs=""
  machines=$(machines_tsv || true)
  if [[ -n $machines ]] && command -v ssh >/dev/null 2>&1; then
    # '%s\n', not '%s': the command substitution above stripped jq's last
    # newline, and `read` on a final line without one reports EOF and the
    # while loops below would silently skip the last machine.
    if quiet_private_dir "$CACHE_DIR"; then
      printf '%s\n' "$machines" | machine_window_pairs > "$CACHE_DIR/window-pairs.tsv.tmp" &&
        mv -f -- "$CACHE_DIR/window-pairs.tsv.tmp" "$CACHE_DIR/window-pairs.tsv" &&
        pairs="$CACHE_DIR/window-pairs.tsv"
    fi
    printf '%s\n' "$machines" | gather_machines
  fi

  local windows
  if [[ -n $pairs ]]; then windows=$(window_map "$pairs" || true)
  else windows=$(window_map || true); fi

  # The snapshots are collected here rather than in jq, because each one is a
  # separate command. They go in as a name-keyed object, so the merge below is
  # a lookup instead of a search.
  #
  # The object is assembled as text rather than folded together with a jq call
  # per session: this runs every few seconds, and a jq start costs more than
  # everything else in this function put together. The key is safe to splice
  # in unquoted because valid_session_name has already refused anything but
  # letters, digits, dot, dash and underscore.
  # A session that is not running has no server to ask, but it has not
  # forgotten anything either: herdr writes the layout to session.json, and
  # that file still names the workspaces and the directory each one was opened
  # in. Reading it is what makes a stopped row say what it is holding rather
  # than only that it is down - the difference between a session worth starting
  # back up and a name left over from an afternoon.
  local snapshots='' saved='' name is_default running dir snap labels
  # Two ceilings on the loop itself. The per-source caps above bound any one
  # answer; these bound the sum of them, which is the case a hundred sessions
  # each just under their own limit would otherwise walk straight through.
  local seen=0 dropped=0
  while IFS=$'\t' read -r name is_default running dir; do
    [[ -n $name ]] || continue
    valid_session_name "$name" || continue

    if (( seen >= SESSION_COUNT_CAP )); then
      dropped=$(( dropped + 1 ))
      continue
    fi
    if (( ${#snapshots} + ${#saved} > TOTAL_BYTE_CAP )); then
      dropped=$(( dropped + 1 ))
      continue
    fi
    seen=$(( seen + 1 ))

    if [[ $running == true ]]; then
      snap=$(snapshot_for "$name" "$is_default") || continue
      snapshots+="${snapshots:+,}\"$name\":$snap"
      continue
    fi

    readable_file "$dir/session.json" || continue
    # The label herdr shows is the name a workspace was given, and the last
    # part of the directory it was opened in otherwise - the same two, in the
    # same order, that a running snapshot resolves to its label.
    # Read through a ceiling rather than handed to jq whole: this file is on
    # disk and nothing here decided how big it is.
    over_byte_cap "$(head -c "$((SESSION_FILE_CAP + 1))" -- "$dir/session.json" 2>/dev/null || true)" \
      "$SESSION_FILE_CAP" && continue
    labels=$(jq -c --arg home "$HOME" '[.workspaces[]?
                     | (.custom_name
                        // (if (.identity_cwd // "") == $home then "~"
                            else (.identity_cwd // "" | split("/") | last) end))
                     | select(. != null and . != "")]
                    | unique' -- "$dir/session.json" 2>/dev/null) || continue
    [[ -n $labels ]] || continue
    saved+="${saved:+,}\"$name\":$labels"
  done < <(printf '%s' "$sessions_json" |
    jq -r '.sessions[]? | "\(.name)\t\(.default // false)\t\(.running // false)\t\(.session_dir // "")"')
  # Every machine that answered becomes a row of its own under the key the
  # window pairing knows it by. One that did not answer keeps the row it last
  # answered with - or, if it has never answered, a quiet row that says so -
  # marked unreachable, so a machine that went away holds its place in the
  # list and says what happened to it rather than vanishing from under the
  # cursor. That is what herdr's own sidebar does with a lost connection:
  # dimmed, not gone.
  declare -A m_target_of=() m_label_of=() m_session_of=()
  local m_id m_label m_target m_session m_key m_snapfile m_cached m_row m_snap
  while IFS=$'\t' read -r m_id m_label m_target m_session; do
    [[ $m_id =~ ^[A-Za-z0-9_-]{6,64}$ ]] || continue
    [[ -n $m_target && $m_target != *$'\n'* && $m_target != *" "* ]] || continue
    valid_session_name "$m_session" || continue
    m_target_of[$m_id]=$m_target
    m_label_of[$m_id]=$m_label
    m_session_of[$m_id]=$m_session
  done <<<"$machines"

  local stubs='' down='' seen_machines=0
  for m_id in "${!m_target_of[@]}"; do
    if (( seen_machines >= REMOTE_COUNT_CAP )) ||
       (( ${#snapshots} + ${#down} > TOTAL_BYTE_CAP )); then
      break
    fi
    m_key="$m_id:${m_session_of[$m_id]}"
    m_snapfile="$CACHE_DIR/machines/$m_id.snap"
    if readable_file "$m_snapfile"; then
      m_snap=$(head -c "$((SNAPSHOT_BYTE_CAP + 1))" -- "$m_snapfile" 2>/dev/null) || m_snap=""
      if [[ -n $m_snap ]] && ! over_byte_cap "$m_snap" "$SNAPSHOT_BYTE_CAP" \
         && printf '%s' "$m_snap" | jq -e . >/dev/null 2>&1; then
        snapshots+="${snapshots:+,}\"$m_key\":$m_snap"
        stubs+="${stubs:+,}{\"name\":\"$m_key\",\"default\":false,\"running\":true,\"remote\":true,\"machine\":$(json_string "${m_label_of[$m_id]}")}"
        seen_machines=$((seen_machines + 1))
        continue
      fi
    fi
    m_row=""
    m_cached="$CACHE_DIR/machines/$m_id.row"
    if readable_file "$m_cached"; then
      m_row=$(head -c "$((SNAPSHOT_BYTE_CAP + 1))" -- "$m_cached" 2>/dev/null) || m_row=""
      [[ -n $m_row ]] && printf '%s' "$m_row" | jq -e . >/dev/null 2>&1 || m_row=""
    fi
    if [[ -z $m_row ]]; then
      m_row=$(jq -cn --arg name "$m_key" --arg machine "${m_label_of[$m_id]}" \
        '{name:$name, isDefault:false, running:false, unreachable:true, remote:true,
          machine:$machine, version:"", agents:0, working:0, blocked:0, idle:0, done:0,
          workspaces:0, agentList:[], projects:[], windowAddress:""}')
    fi
    down+="${down:+,}\"$m_key\":$m_row"
  done

  snapshots="{$snapshots}"
  saved="{$saved}"
  stubs="[$stubs]"
  down="{$down}"
  printf '%s' "$saved" | jq -e . >/dev/null 2>&1 || saved="{}"
  # A truncated or unparseable reply from any one server must not take the
  # whole list down with it.
  printf '%s' "$snapshots" | jq -e . >/dev/null 2>&1 || snapshots='{}'
  printf '%s' "$stubs" | jq -e . >/dev/null 2>&1 || stubs='[]'
  printf '%s' "$down" | jq -e . >/dev/null 2>&1 || down='{}'

  local out
  out=$(printf '%s' "$sessions_json" | jq -c \
    --argjson snapshots "$snapshots" \
    --argjson saved "$saved" \
    --argjson stubs "$stubs" \
    --argjson down "$down" \
    --argjson agentCap "$AGENT_COUNT_CAP" \
    --arg windows "$windows" '
    ($windows | split("\n") | map(select(length > 0) | split("\t"))
      | map({key: .[0], value: .[1]}) | from_entries) as $win
    | ((.sessions // []) + $stubs) as $rows
    | ([$rows[]?
       | .name as $name
       | (($snapshots[$name].result.snapshot) // {}) as $snap
       | ($snap.agents // []) as $agents
       # Workspace labels live on the workspace, the agent only carries the id
       # it sits in, so they are joined here rather than in the panel: one
       # place turns what herdr says into what gets drawn.
       | (($snap.workspaces // [])
          | map({key: (.workspace_id // ""), value: (.label // "")})
          | from_entries) as $wslabels
       | {
           name: $name,
           isDefault: (.default // false),
           running: (.running // false),
           remote: (.remote // false),
           machine: (.machine // ""),
           version: ($snap.version // ""),
           agents: ($agents | length),
           working: ([$agents[] | select(.agent_status == "working")] | length),
           blocked: ([$agents[] | select(.agent_status == "blocked")] | length),
           idle:    ([$agents[] | select(.agent_status == "idle")] | length),
           done:    ([$agents[] | select(.agent_status == "done")] | length),
           workspaces: (($snap.workspaces // []) | length),
           agentList: ($agents
                       | map({title: (.terminal_title_stripped // .terminal_title // ""),
                              status: (.agent_status // "unknown"),
                              pane: (.pane_id // ""),
                              workspace: ($wslabels[.workspace_id // ""] // ""),
                              # Herdr bumps this every time an agent changes
                              # state. Passed through so the panel can tell
                              # two agents that both want something apart by
                              # which one spoke last.
                              seq: (.state_change_seq // 0)})
                       | map(select(.title != ""))
                       # The attention queue herdr uses itself, the order its
                       # own agent panel takes when agent_panel_sort is set to
                       # priority: what wants an answer, then what finished
                       # unseen, then what is busy, then what is only waiting
                       # for you to type. Sorting is stable in jq, so agents
                       # sharing a state keep the order herdr laid them out in.
                       | sort_by(if   .status == "blocked" then 0
                                 elif .status == "done"    then 1
                                 elif .status == "working" then 2
                                 elif .status == "idle"    then 3
                                 else 4 end)
                                 # After the sort, so the cap keeps what wants an answer rather
                                 # than whatever the server happened to list first. The counts
                                 # above stay honest: they are taken from the full set.
                                 | .[0:$agentCap]),
           projects: (if (.running // false)
                      then (($snap.workspaces // []) | map(.label // "")
                            | map(select(length > 0)) | unique)
                      else ($saved[$name] // []) end),
           windowAddress: ($win[$name] // "")
         }]
       # The rows of machines that did not answer, from the cache: kept as
       # they last were, marked so the panel dims them and says so, their
       # window address still live because the window is still a local
       # window even when the host behind it is gone.
       + ($down | to_entries | map(.key as $k
           | .value + {unreachable: true, running: false,
                       windowAddress: ($win[$k] // "")})))
    | sort_by([(if .remote == true then 1 else 0 end),
               (if .isDefault then 0 else 1 end),
               (if .running then 0 else 1 end),
               ((if .remote == true then .machine else .name end) | ascii_downcase)])
    | {ok: true,
       error: "",
       sessions: .,
       running: ([.[] | select(.running)] | length),
       agents: ([.[] | .agents] | add // 0),
       blocked: ([.[] | .blocked] | add // 0),
       done: ([.[] | .done] | add // 0),
       working: ([.[] | .working] | add // 0)}
  ' 2>/dev/null) || die "unexpected output from herdr"

  # The row each machine answered with is kept for the next time it goes
  # quiet, and rows for profiles that are gone - removed or disabled - do
  # not stay behind in the cache.
  if quiet_private_dir "$CACHE_DIR/machines"; then
    while IFS= read -r m_row; do
      [[ -n $m_row ]] || continue
      m_key=$(printf '%s' "$m_row" | jq -r '.name // ""')
      [[ $m_key == *:* ]] || continue
      m_id=${m_key%%:*}
      [[ $m_id =~ ^[A-Za-z0-9_-]{6,64}$ ]] || continue
      printf '%s' "$m_row" > "$CACHE_DIR/machines/$m_id.row.tmp" &&
        mv -f -- "$CACHE_DIR/machines/$m_id.row.tmp" "$CACHE_DIR/machines/$m_id.row"
    done < <(printf '%s' "$out" |
      jq -r '.sessions[]? | select(.remote == true and .unreachable != true) | tojson' 2>/dev/null)
    for m_cached in "$CACHE_DIR"/machines/*; do
      [[ -e $m_cached ]] || continue
      m_id=${m_cached##*/}
      m_id=${m_id%%.*}
      [[ -n ${m_target_of[$m_id]-} ]] || rm -f -- "$m_cached"
    done
  fi

  printf '%s\n' "$out"
}

# ------------------------------------------------------------- open a session

# Bring up the window showing a session, or start one. Returns 0 once
# something has been done, 1 when no terminal could be started.
show_session() {
  local name="$1"

  local address workspace
  IFS=$'\t' read -r address workspace < <(
    window_map | awk -F'\t' -v want="$name" '$1 == want { print $2 "\t" $3; exit }')

  # Both values are spliced into a Lua expression, so they are checked for
  # shape first rather than escaped. A window address is hex; a workspace name
  # is a number, a name, or "special:<name>". Anything else means the window
  # is not what we think it is, and focusing is not worth guessing at.
  if [[ $address =~ ^0x[0-9a-fA-F]+$ ]]; then
    # A window on another workspace stays hidden however hard it is focused:
    # focus picks the window, it does not bring its workspace into view. So
    # switch first, then focus - which also lands on the right monitor when
    # the workspace lives on the other screen.
    if [[ $workspace =~ ^(special:)?[A-Za-z0-9_-]{1,32}$ ]]; then
      hyprctl dispatch "hl.dsp.focus({ workspace = '$workspace' })" >/dev/null 2>&1
    fi
    # Quattro's hyprctl parses its argument as Lua, so `dispatch focuswindow`
    # is a syntax error now. The address is single-quoted inside the Lua call.
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })" >/dev/null 2>&1
    return 0
  fi

  # No window: open one. A numbered session is named after the Hyprland
  # workspace it belongs to, so it is opened there rather than on top of
  # whatever is in front of you - otherwise "Workspace 4" would land on
  # workspace 7 and the name would stop meaning anything.
  if [[ $name =~ ^[0-9]{1,3}$ ]]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = '$name' })" >/dev/null 2>&1
  fi

  # `herdr --session <name>` attaches to the server that is already running
  # under that name and only starts one when there is none, so the same
  # command covers a running session with no window and a stopped one. The
  # session keeps its own state, so the directory only matters the very first
  # time a name is used.
  local -a herdr_cmd=(herdr)
  [[ $name == default ]] || herdr_cmd+=(--session "$name")

  spawn_terminal_herdr "${herdr_cmd[@]}"
}

# Start a terminal running the herdr command given, detached from this script
# so the panel never waits on it. Foot by name rather than through
# xdg-terminal-exec: the app id is what window rules and the window matching
# above key off, and a terminal chosen from the desktop's list is not
# guaranteed to take one. xdg-terminal-exec stays as the fallback for a
# machine without foot.
spawn_terminal_herdr() {
  local -a launch=()
  if command -v uwsm-app >/dev/null 2>&1; then
    launch=(setsid uwsm-app --)
  else
    launch=(setsid)
  fi

  if command -v foot >/dev/null 2>&1; then
    launch+=(foot "--app-id=$APP_ID" "--working-directory=$HOME" -e "$@")
  elif command -v xdg-terminal-exec >/dev/null 2>&1; then
    launch+=(xdg-terminal-exec "--app-id=$APP_ID" "--dir=$HOME" -- "$@")
  else
    return 1
  fi

  "${launch[@]}" >/dev/null 2>&1 &
  disown
  return 0
}

# A machine profile by id: "target<TAB>session", straight from herdr's own
# catalog. Enabled only - a disabled machine is not listed and not opened.
machine_meta_for() {
  herdr machine list --json 2>/dev/null |
    jq -r --arg id "$1" 'map(select(.id == $id and .enabled == true))[0]
      | if . then "\(.target)\t\(.session // "default")" else empty end' 2>/dev/null || true
}

# The machine half of "open": focus the window already attached to it, or
# start an attach in a terminal of its own. `herdr --remote <target>` is the
# command herdr's own docs give for a machine that needs attention, and it
# attaches to the server that is running without starting anything when
# there is one - the same rule a local session opens by, and the window it
# leaves behind is the one the pairing above recognises next time.
open_remote() {
  local name="$1"
  local mid=${name%%:*} session=${name#*:}

  local meta target
  meta=$(machine_meta_for "$mid") || true
  [[ -n $meta ]] || return 1
  IFS=$'\t' read -r target session <<<"$meta"

  local address workspace
  local pairs=""
  readable_file "$CACHE_DIR/window-pairs.tsv" && pairs="$CACHE_DIR/window-pairs.tsv"
  IFS=$'\t' read -r address workspace < <(
    window_map "$pairs" | awk -F'\t' -v want="$name" '$1 == want { print $2 "\t" $3; exit }')

  if [[ $address =~ ^0x[0-9a-fA-F]+$ ]]; then
    if [[ $workspace =~ ^(special:)?[A-Za-z0-9_-]{1,32}$ ]]; then
      hyprctl dispatch "hl.dsp.focus({ workspace = '$workspace' })" >/dev/null 2>&1
    fi
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })" >/dev/null 2>&1
    return 0
  fi

  local -a herdr_cmd=(herdr --remote "$target")
  [[ $session == default ]] || herdr_cmd+=(--session "$session")
  spawn_terminal_herdr "${herdr_cmd[@]}"
}

cmd_open() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  # A machine's row opens by attaching to it over SSH; everything else is a
  # local session and opens the way it always has.
  if [[ $name == *:* ]]; then
    open_remote "$name" || die "no terminal available"
  else
    show_session "$name" || die "no terminal available"
  fi
  printf '{"ok":true}\n'
}

# Land on one agent rather than on whatever the session was last showing.
#
# The pane is focused over the socket first, so the server has already moved
# by the time the window comes up - and it moves even when there is no window
# at all, which is what makes this work on a session that has to be opened.
# `herdr agent focus` switches workspace and tab inside the session on its
# own; the hyprctl half below is only about which window is in front of you.
cmd_focus() {
  local name="${1-}" pane="${2-}"
  valid_session_name "$name" || die "not a session name"
  valid_pane_id "$pane" || die "not a pane id"

  # A machine's agent is focused on its own server first, over SSH, with the
  # same command the local branch runs; then the window comes up the way any
  # machine's window does. The remote focus is best effort: a machine that
  # is not answering still gets its window, which is the half of the click
  # that works from here.
  if [[ $name == *:* ]]; then
    local mid=${name%%:*} meta target rsession bin
    meta=$(machine_meta_for "$mid") || true
    [[ -n $meta ]] || die "no such machine"
    IFS=$'\t' read -r target rsession <<<"$meta"
    bin=$(remote_herdr_bin "$target" "$mid") || bin=""
    if [[ -n $bin ]]; then
      local -a rcmd=("$bin")
      [[ $rsession == default ]] || rcmd+=(--session "$rsession")
      rcmd+=(agent focus "$pane")
      timeout "$REMOTE_CALL_TIMEOUT" ssh "${REMOTE_SSH_OPTS[@]}" "$target" "${rcmd[*]}" >/dev/null 2>&1 || true
    fi
    open_remote "$name" || die "no terminal available"
    printf '{"ok":true}\n'
    return
  fi

  # No `--` before the pane id: herdr does not take one, and valid_pane_id has
  # already refused anything but two runs of letters, digits, dash and
  # underscore around a colon - so nothing here can arrive looking like an
  # option in the first place.
  if [[ $name == default ]]; then
    herdr agent focus "$pane" >/dev/null 2>&1 || true
  else
    herdr --session "$name" agent focus "$pane" >/dev/null 2>&1 || true
  fi

  show_session "$name" || die "no terminal available"
  printf '{"ok":true}\n'
}

# ------------------------------------------------------------ kill / delete

# Which process is serving a session. Every herdr server has the same command
# line - a bare `herdr server`, with no session name on it - so the socket it
# is listening on is the only thing that tells them apart. `ss` is what maps a
# listening unix socket back to the process holding it.
server_pid_for() {
  local socket="$1" pid
  [[ -n $socket ]] || return 1
  pid=$(ss -lpxn 2>/dev/null | awk -v want="$socket " '
    index($0, want) == 0 { next }
    match($0, /pid=[0-9]+/) { print substr($0, RSTART + 4, RLENGTH - 4); exit }')
  [[ $pid =~ ^[0-9]+$ ]] || return 1

  # A pid read out of another tool's output is a pid to check before signalling.
  # It has to still be a herdr server: `ss` was run a moment ago, and a pid that
  # exited since then belongs to whatever was started next.
  local comm=""
  { read -r comm < "/proc/$pid/comm"; } 2>/dev/null || return 1
  [[ $comm == herdr ]] || return 1
  grep -qz server "/proc/$pid/cmdline" 2>/dev/null || return 1

  printf '%s' "$pid"
}

socket_of() {
  herdr session list --json 2>/dev/null |
    jq -r --arg name "$1" '.sessions[]? | select(.name == $name) | .socket_path // ""' 2>/dev/null
}

# How a server is ended here, and the only way. `herdr session stop` asks over
# the socket, so a server too wedged to read that socket never hears it and the
# button looks broken at exactly the moment it is needed. A signal reaches the
# process either way, so there is nothing for the tidy route to be better at.
#
# TERM first and KILL only if that was not enough: a server given the chance to
# close its sockets leaves no stale ones behind, and on a healthy server the
# first signal is all it takes. The default session is killed like any other.
cmd_kill() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  [[ $name == *:* ]] && die "a remote machine is not killed from here"

  local pid
  pid=$(server_pid_for "$(socket_of "$name")") || die "no running server for that session"

  kill -TERM "$pid" 2>/dev/null || true
  local i
  for ((i = 0; i < 10; i++)); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null

  printf '{"ok":true}\n'
}

cmd_delete() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  [[ $name == default ]] && die "the default session is not deleted from here"
  [[ $name == *:* ]] && die "a remote machine is not deleted from here"
  # No `--` before the name: herdr's argument parser does not take one, and a
  # session name has already been checked against the shape above.
  herdr session delete "$name" >/dev/null 2>&1 || true
  printf '{"ok":true}\n'
}

# ------------------------------------------------------------------- main

require_tools

case "${1:-list}" in
  list) if demo_on; then demo_list; else cmd_list; fi ;;
  # Every write is a no-op while the demo is on, so a click during a shoot
  # cannot reach a real session.
  open) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_open "${1-}"; fi ;;
  focus) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_focus "${1-}" "${2-}"; fi ;;
  kill) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_kill "${1-}"; fi ;;
  delete) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_delete "${1-}"; fi ;;
  demo) shift; cmd_demo "${1-}" ;;
  *) die "unknown command" ;;
esac
