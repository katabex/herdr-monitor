{"name":"0d3b7e5c91a2f4b68d0c7e3a5f1b2c94:default","isDefault":false,"remote":true,"machine":"laptop","running":false,"unreachable":true,"version":"","agents":1,"working":0,"blocked":0,"idle":0,"done":1,"workspaces":1,"projects":["notes"],"agentList":[{"title":"Rebuild the search index","status":"done","pane":"w1:p1","seq":19}],"windowAddress":""}
],"running":4,"agents":8,"blocked":1,"done":3,"working":2}
